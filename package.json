{
  "name": "cdn-resolve",
  "version": "3.0.0",
  "description": "Resolves import paths to their CDN equivalents",
  "keywords": [
    "cdn",
    "esm.sh",
    "import",
    "jsdelivr",
    "resolve",
    "unpkg"
  ],
  "homepage": "https://github.com/luxass/cdn-resolve",
  "bugs": {
    "url": "https://github.com/luxass/cdn-resolve/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Lucas Nørgård",
    "email": "lucasnrgaard@gmail.com",
    "url": "https://luxass.dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/luxass/cdn-resolve.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.cts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    },
    "./esm": {
      "import": "./dist/esm.mjs",
      "require": "./dist/esm.cjs"
    },
    "./jsdelivr": {
      "import": "./dist/jsdelivr.mjs",
      "require": "./dist/jsdelivr.cjs"
    },
    "./parse": {
      "import": "./dist/parse.mjs",
      "require": "./dist/parse.cjs"
    },
    "./unpkg": {
      "import": "./dist/unpkg.mjs",
      "require": "./dist/unpkg.cjs"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "catalog:types",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:dev",
    "publint": "catalog:dev",
    "tsdown": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:test"
  },
  "engines": {
    "node": ">=22"
  },
  "packageManager": "pnpm@12.21.0"
}
